# Public project URL and publishable key only. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable each provider only after the owner confirms it and Supabase is configured.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=false
# Server only. Used solely for audited invitation delivery and operator bootstrap.
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# Jira server credentials for managed production hosting. Never NEXT_PUBLIC_.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ORGANIZATION_ID=
JIRA_TOKEN_TYPE=classic
# OAuth production configuration. Generate a random 32-byte base64 encryption key.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_ENCRYPTION_KEY=
# Google Sheets server configuration for managed hosting. Never NEXT_PUBLIC_.
# JSON service account credentials; share only the approved spreadsheet as Editor.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ORGANIZATION_ID=
# Explicit active Sales employee membership UUIDs, comma-separated. Owner always has access.
GOOGLE_SHEETS_SALES_MEMBERSHIP_IDS=
# Secret for the external scheduler that calls /api/cron/sync (min 32 characters). See docs/SCHEDULED-SYNC.md
CRON_SECRET=

# Campaigns (Owner only). Names only here; set real values in the hosting settings. See docs/CAMPAIGNS-SETUP.md
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_IDS=
# META_GRAPH_VERSION=v25.0
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# Optional Jira webhook (signed pushes instead of polling). Secret must be at least 32 characters.
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_ORGANIZATION_ID=
